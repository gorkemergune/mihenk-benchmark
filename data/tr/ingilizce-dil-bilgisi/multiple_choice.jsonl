{"id": "MIHENK-ENGRAM-TR-L1-0002", "language": "tr", "discipline": "İngilizce Dil Bilgisi", "format": "multiple_choice", "difficulty": "L1", "question": "İngilizcede 'go' fiilinin geçmiş zaman (past simple) hâli hangisidir?", "choices": {"A": "goed", "B": "goes", "C": "went", "D": "gone"}, "answer": "C", "answer_short": null, "explanation": "'go' düzensiz fiildir; past simple hâli 'went'tir. ('gone' past participle'dır.)", "tags": ["past-simple", "düzensiz-fiil"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
