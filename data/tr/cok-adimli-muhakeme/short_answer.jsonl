{"id": "MIHENK-MULTI-TR-L3-0017", "language": "tr", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L3", "question": "200 TL'nin önce %10'u, ardından kalan tutarın %50'si harcanıyor. Geriye kaç TL kalır?", "choices": null, "answer": null, "answer_short": "90", "answer_aliases": ["90 TL"], "explanation": "İlk harcama 20 TL, kalan 180 TL; ikinci harcama 180 × 0,50 = 90 TL, geriye 90 TL kalır.", "tags": ["yüzde", "ardışık-işlem", "çok-adımlı"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-MULTI-TR-L3-0018", "language": "tr", "discipline": "Çok Adımlı Muhakeme", "format": "short_answer", "difficulty": "L3", "question": "Bir araç 2 saat boyunca 60 km/s, ardından 1 saat boyunca 90 km/s hızla gidiyor. Toplam kaç km yol alır?", "choices": null, "answer": null, "answer_short": "210", "answer_aliases": ["210 km"], "explanation": "2 × 60 = 120 km; 1 × 90 = 90 km; toplam 120 + 90 = 210 km.", "tags": ["hız-yol", "çok-adımlı"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
