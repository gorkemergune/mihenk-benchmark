{"id": "MIHENK-TRGRAM-TR-L1-0012", "language": "tr", "discipline": "Türkçe Dil Bilgisi", "format": "short_answer", "difficulty": "L1", "question": "'güzel çiçek' tamlamasında 'güzel' sözcüğü hangi tür bir sözcüktür? (tek kelime)", "choices": null, "answer": null, "answer_short": "sıfat", "answer_aliases": ["sıfattır", "ön ad"], "explanation": "'güzel', 'çiçek' ismini niteleyen bir sıfattır (ön ad).", "tags": ["sıfat", "sözcük-türü"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "public"}
{"id": "MIHENK-TRGRAM-TR-L1-0013", "language": "tr", "discipline": "Türkçe Dil Bilgisi", "format": "short_answer", "difficulty": "L1", "question": "Bir cümlede iş, oluş veya durum bildiren ve cümlenin temel ögesi olan öge hangisidir? (tek kelime)", "choices": null, "answer": null, "answer_short": "yüklem", "answer_aliases": ["yüklemdir"], "explanation": "Cümlenin temel ögesi, eylem veya yargı bildiren yüklemdir.", "tags": ["cümle-ögeleri", "yüklem"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-TRGRAM-TR-L2-0014", "language": "tr", "discipline": "Türkçe Dil Bilgisi", "format": "short_answer", "difficulty": "L2", "question": "'Koşarak geldi.' cümlesindeki 'koşarak' sözcüğü hangi tür fiilimsidir? (iki kelime)", "choices": null, "answer": null, "answer_short": "zarf-fiil", "answer_aliases": ["zarf fiil", "bağ-fiil", "ulaç"], "explanation": "'-arak' ekiyle türeyen 'koşarak', yüklemin durumunu bildiren bir zarf-fiildir (bağ-fiil).", "tags": ["fiilimsi", "zarf-fiil"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
{"id": "MIHENK-TRGRAM-TR-L2-0015", "language": "tr", "discipline": "Türkçe Dil Bilgisi", "format": "short_answer", "difficulty": "L2", "question": "'Ayşe'nin kalemi' tamlaması hangi tür isim tamlamasıdır? (üç kelime)", "choices": null, "answer": null, "answer_short": "belirtili isim tamlaması", "answer_aliases": ["belirtili ad tamlaması", "belirtili"], "explanation": "Tamlayan (Ayşe'nin) ilgi eki, tamlanan (kalemi) iyelik eki aldığından belirtili isim tamlamasıdır.", "tags": ["isim-tamlaması", "belirtili"], "source": "orijinal-AI-üretim", "version_added": "1.0", "split": "private"}
